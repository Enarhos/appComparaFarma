API_SECRET_KEY=
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SEARCH_CACHE_TTL_MS=300000
# Upstash Redis — obtener en upstash.com → proyecto → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Algolia — Salcobrand search index (GM3RP06HJG / sb_variant_production)
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
# Sentry — sentry.io → crear proyecto "Node.js" → Settings → Client Keys (DSN)
# Si se deja vacío, el backend no reporta errores a Sentry (no-op)
SENTRY_DSN=
# Banner de donación — DONATION_BANNER_ENABLED=false lo apaga para todos los usuarios
# DONATION_BANNER_DISMISS_DAYS controla cuánto dura "No mostrar por ahora" (default: 7)
DONATION_BANNER_ENABLED=
DONATION_BANNER_DISMISS_DAYS=
# Supabase — Project Settings → API Keys (usar la "Secret key", nunca la publishable)
# Si se deja vacío, no se graba historial de precios (no-op)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Resend — resend.io → API Keys (usado en /api/feedback y /api/alerts)
# Si se deja vacío, no se envían emails (se loguea y sigue funcionando)
RESEND_API_KEY=
# Secreto compartido con el cron de GitHub Actions que dispara la revisión
# diaria de alertas de precio (GET /api/alerts?action=check&secret=...).
# A diferencia de API_SECRET_KEY, esta ruta NO tiene fallback abierto si se
# deja vacía — sin CRON_SECRET configurado, /api/alerts?action=check
# rechaza todas las solicitudes (evita que cualquiera dispare envío masivo
# de emails).
CRON_SECRET=
# Secreto compartido en la URL de push de Google Cloud Pub/Sub (Real-Time
# Developer Notifications de Google Play), verificado en
# /api/subscriptions?action=google-rtdn&token=... — mismo criterio que
# CRON_SECRET: sin este valor configurado, la ruta rechaza todas las
# solicitudes (no hay fallback abierto). Se genera al configurar el tópico
# de Pub/Sub en Play Console (ver CF-114, docs/engineering/issues/).
GOOGLE_RTDN_SECRET=
# Stripe — Subscription Platform Fase 2 (RFC-004). dashboard.stripe.com →
# Developers → API keys (Secret key) / Webhooks (crear un endpoint apuntando
# a https://comparafarma-api.vercel.app/api/subscriptions?action=stripe-webhook
# y copiar su "Signing secret"). Sin STRIPE_SECRET_KEY, create-checkout-session
# responde 503 explícito. Sin STRIPE_WEBHOOK_SECRET, stripe-webhook rechaza
# todo (sin fallback abierto — hay dinero real de por medio).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública de web/ — usada para construir success_url/cancel_url del
# Checkout de Stripe server-side (nunca se aceptan esas URLs del cliente,
# evita open redirect).
WEB_APP_URL=https://app-compara-farma-web.vercel.app
