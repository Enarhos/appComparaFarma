# Backend de ComparaFarma — el fetch de búsqueda corre server-side (RSC), sin prefijo NEXT_PUBLIC_
API_URL=https://comparafarma-api.vercel.app
# Opcional — mismo valor que API_SECRET_KEY en api/.env.example. Usado en
# profilesAdmin.ts (CF-116) para autenticar las llamadas server-to-server a
# /api/subscriptions?action=grant-manual/revoke-manual. Si se deja vacío,
# funciona igual (api/ tiene fallback abierto si tampoco está configurado ahí).
API_SECRET_KEY=
# URL pública de este sitio (para metadata/OG) — actualizar con el dominio real una vez que exista
SITE_URL=https://comparafarma.vercel.app

# Panel /admin — mismo proyecto Supabase que usa api/ (ver api/.env.example)
# Anon/publishable key: Supabase Dashboard → Settings → API → "anon public" / "publishable"
# (NO es la secret key — esta sí se expone al navegador, solo habilita login, no bypassea RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xzdtpypctyntkgmoceum.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key — solo se usa server-side (Server Components) para leer datos agregados del dashboard
SUPABASE_URL=https://xzdtpypctyntkgmoceum.supabase.co
SUPABASE_SECRET_KEY=

# Lista blanca de emails con acceso a /admin (coma-separado). Obligatorio si se
# habilita el proveedor Google en Supabase Auth — sin esto, cualquier cuenta de
# Google podría entrar (Supabase auto-crea el usuario en el primer login OAuth).
ADMIN_ALLOWED_EMAILS=mario.lillo.alfaro@gmail.com
