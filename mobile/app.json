{
  "expo": {
    "name": "ComparaFarma",
    "slug": "compara-farma",
    "scheme": "comparafarma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16a34a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.comparafarma.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "cl.comparafarma.app",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["@sentry/react-native", { "uploadSourceMaps": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4de81d7d-c9ab-470c-be3c-04eb43047e59"
      }
    },
    "owner": "belford"
  }
}
