# Si defines EXPO_PUBLIC_API_URL, la app usará el backend en vez de consultar
# directamente a las farmacias. Si lo omites, se mantiene el fallback local.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry — obtener en https://sentry.io → Settings → Projects → Client Keys
# Solo necesario para builds de producción (ignorado en __DEV__)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@oxxxx.ingest.sentry.io/xxxxx

# Identity Foundation (Épica 1, docs/execution/EPIC-01-IDENTITY_FOUNDATION.md).
# Mismo proyecto Supabase que ya usan web/ y api/ — nunca uno nuevo (ver
# docs/architecture/IDENTITY_INTEGRATION_PLAN.md). Obtener en
# Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
