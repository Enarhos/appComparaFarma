# Si defines EXPO_PUBLIC_API_URL, la app usará el backend en vez de consultar
# directamente a las farmacias. Si lo omites, se mantiene el fallback local.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Solo si configuras API_SECRET_KEY en el backend.
EXPO_PUBLIC_API_KEY=

# Sentry — obtener en https://sentry.io → Settings → Projects → Client Keys
# Solo necesario para builds de producción (ignorado en __DEV__)
EXPO_PUBLIC_SENTRY_DSN=https://xxxxx@oxxxx.ingest.sentry.io/xxxxx
